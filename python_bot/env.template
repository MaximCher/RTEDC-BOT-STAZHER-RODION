# SRVT Bot (.env template)
# Copy to python_bot/.env and fill values.

# ====================================
# TELEGRAM
# ====================================
#
# Compatibility notes:
# - BOT_TOKEN is accepted instead of TELEGRAM_BOT_TOKEN
# - CHAT_ID is accepted instead of MANAGER_CHAT_IDS (single value)
#
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=your_bot_username_without_at

# Manager notifications (Telegram chat/user id). Multiple: comma-separated
MANAGER_CHAT_IDS=123456789,-1001234567890
# CHAT_ID=-1001234567890

# Main group where join requests should be moderated (MAIN_GROUP_ID)
MAIN_GROUP_ID=-1001234567890

# ====================================
# DATABASE (PostgreSQL + pgvector)
# ====================================
# Optional: full DSN (recommended for Supabase). If set, it overrides POSTGRES_* below.
# Examples:
# - postgresql://postgres:<PASSWORD>@db.<project>.supabase.co:5432/postgres
# - postgresql+asyncpg://postgres:<PASSWORD>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# SSL mode for Postgres (asyncpg). For Supabase set: require
POSTGRES_SSLMODE=prefer

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=srvt_bot
POSTGRES_USER=srvt
POSTGRES_PASSWORD=ChangeThisToSecurePassword123!

# ====================================
# OPENAI
# ====================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ====================================
# BITRIX24
# ====================================
# Base webhook URL or full endpoint. If base is provided, bot will append /crm.lead.add
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_webhook_key/

# Default responsible (optional). If not set, Bitrix default rules apply.
BITRIX_RESPONSIBLE_DEFAULT_ID=

# Optional default pipeline/category id (depends on your Bitrix setup)
BITRIX_DEFAULT_CATEGORY_ID=

# Optional: custom UF field codes used in your Bitrix for TG metadata
# If empty, bot will still send TG data in COMMENTS.
BITRIX_UF_TG_ID=UF_CRM_TG_ID
BITRIX_UF_TG_USERNAME=UF_CRM_TG_USERNAME
BITRIX_UF_SERVICE_KEY=UF_CRM_SRV_SERVICE

# ====================================
# UNITELLER PAYMENTS
# ====================================
UNITELLER_ENABLED=false
UNITELLER_UPID=
UNITELLER_PASSWORD=
UNITELLER_API_URL=https://api.uniteller.ru/simple/register
UNITELLER_RESULTS_URL=https://wpay.uniteller.ru/results/
UNITELLER_RESULTS_LOGIN=
UNITELLER_RESULTS_PASSWORD=
UNITELLER_RESULTS_SHOP_ID=
UNITELLER_RESULTS_FORMAT=4
UNITELLER_ORDER_LIFETIME=24:00
UNITELLER_FORM_LIFETIME=
UNITELLER_CURRENCY=RUB
CONSULTATION_PRICE_RUB=

# ====================================
# APP
# ====================================
LOG_LEVEL=INFO
DEBUG_MODE=false

# ====================================
# ADMIN PANEL (FastAPI)
# ====================================
#
# Compatibility notes:
# - DASHBOARD_PASSWORD is accepted instead of ADMIN_PASSWORD
#
ADMIN_PASSWORD=ChangeThisPassword123!
# DASHBOARD_PASSWORD=ChangeThisPassword123!
WEB_SESSION_SECRET=ChangeThisSecretKey123!
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ====================================
# TELEGRAM MINI APP (Admin panel inside Telegram)
# ====================================
# Public HTTPS URL to admin panel for Telegram WebApp (VPS domain).
WEBAPP_PUBLIC_URL=https://your-domain.example/admin

# Telegram user IDs that are admins (comma-separated). Used to show menu button in Telegram.
ADMIN_USER_IDS=123456789
# ADMIN_IDS=123456789

# ====================================
# TUNA (temporary HTTPS tunnel, useful before domain is ready)
# ====================================
# Put your tuna token here (recommended to set via GitHub Secret and deploy.yml).
TUNA_TOKEN=
# Which local port on VPS should be exposed (we tunnel nginx :80 by default)
TUNA_HTTP_PORT=80
# Optional: try to keep a stable tuna subdomain across restarts.
# If empty, tuna will use a random subdomain each time.
TUNA_SUBDOMAIN=srvt-admin
