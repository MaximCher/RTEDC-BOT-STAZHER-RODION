generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    BigInt
  source    String
  scenario  String
  direction String

  name    String
  phone   String
  company String?

  metadata Json?
}

model CaseLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId    BigInt
  text      String
  direction String
  summary   String?
  advice    String?
  raw       Json?
}

model SubsidyProgram {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  title        String
  description  String

  sectors      String[]  @default([])
  costTypes    String[]  @default([])
  regions      String[]  @default([])
  keywords     String[]  @default([])
  isExport     Boolean   @default(false)

  minBudget    Int?
  maxBudget    Int?
  coverageRate Float?
  maxAmount    Int?

  conditions   String?
  recipient    String?
  docsRequired String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

