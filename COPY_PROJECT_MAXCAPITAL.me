#### 2. `services.py` - Выбор услуги и анкетирование

Состояния FSM
```python
class ServiceQuestionnaire(StatesGroup)
    waiting_for_answer = State()
```

Обработчик выбора услуги
```python
@router.callback_query(F.data.startswith(service))
async def handle_service_selection(callback CallbackQuery, state FSMContext, session AsyncSession)
    service_key = callback.data.split()[1]
    flow = SERVICE_FLOWS.get(service_key)
    
    # Особый случай individual_consultation
    if service_key == individual_consultation
        await state.update_data(
            selected_service=service_key,
            consultation_mode=True
        )
        await UserMemory.add_message(session, user_id, system, 
                                     fКлиент выбрал услугу {SERVICES[service_key]})
        await callback.message.edit_text(
            text=MESSAGES[consultation],
            reply_markup=_common_actions_keyboard()
        )
        return
    
    # Для остальных - анкета
    await state.update_data(
        selected_service=service_key,
        questionnaire_index=0,
        questionnaire_answers=[],
        consultation_mode=False
    )
    
    await state.set_state(ServiceQuestionnaire.waiting_for_answer)
    
    # Показать описание + первый вопрос
    text = f{flow['description']}nn{flow['questions'][0]}
    await callback.message.edit_text(text, reply_markup=get_back_keyboard())
```

Обработка ответов на анкету
```python
@router.message(ServiceQuestionnaire.waiting_for_answer)
async def handle_questionnaire_answer(message Message, state FSMContext, session AsyncSession)
    user_id = message.from_user.id
    user_answer = message.text
    
    state_data = await state.get_data()
    service_key = state_data.get(selected_service)
    index = state_data.get(questionnaire_index, 0)
    answers = state_data.get(questionnaire_answers, [])
    
    flow = SERVICE_FLOWS[service_key]
    questions = flow[questions]
    
    # Сохранить ответ
    question_text = questions[index]
    answers.append({question question_text, answer user_answer})
    await UserMemory.add_message(session, user_id, user, 
                                f{question_text}nОтвет {user_answer})
    
    index += 1
    
    # Если анкета завершена
    if index = len(questions)
        # Собрать текст анкеты
        summary_lines = [fАнкета по направлению {flow['direction_label']}]
        for item in answers
            summary_lines.append(f{item['question']}nОтвет {item['answer']})
        summary_text = nn.join(summary_lines)
        
        # Попытка извлечь ФИО и телефон
        full_name = answers[0]['answer'].strip()  # Обычно первый вопрос
        phone = extract_phone_from_text( .join(a['answer'] for a in answers))
        
        # Создать лид в Bitrix24
        bitrix_client = BitrixClient()
        result = await bitrix_client.create_lead(
            full_name=full_name or fTelegram {user_id},
            phone=phone or ,
            selected_service=service_key,
            comment=summary_text,
