async def create_lead(
    self,
    full_name str,
    phone str,
    selected_service str,
    comment Optional[str] = None,
    user_id Optional[int] = None
) - Dict[str, Any]
    # Парсинг имени
    name_parts = full_name.strip().split()
    last_name = name_parts[0] if len(name_parts)  0 else 
    first_name = name_parts[1] if len(name_parts)  1 else 
    
    # Убрать эмодзи из названия услуги
    service_name_raw = SERVICES.get(selected_service, selected_service)
    service_name = re.sub(r'[^ws-()А-Яа-яA-Za-z]', '', service_name_raw).strip()
    
    # Формат комментария
    full_comment = self._format_comment(service_name, comment, user_id)
    
    # Данные лида
    lead_data = {
        fields {
            TITLE fЛид из Telegram бота - {service_name},
            NAME first_name if first_name else ,
            LAST_NAME last_name if last_name else ,
            PHONE [{VALUE phone, VALUE_TYPE WORK}],
            COMMENTS full_comment
        }
    }
    
    # POST запрос
    async with httpx.AsyncClient(timeout=30.0) as client
        response = await client.post(self.webhook_url, json=lead_data)
        result = response.json()
    
    if response.status_code == 200 and result.get('result')
        lead_id = result['result']
        return {success True, lead_id lead_id}
    else
        error_msg = result.get('error_description', 'Unknown error')
        return {success False, error error_msg}
