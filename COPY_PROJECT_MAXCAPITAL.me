function renderUsers(users) {
    const container = document.getElementById('users-list');
    container.innerHTML = users.map(user = `
        div class=user-card onclick=openConversation(${user.user_id})
            div class=user-info
                strong${user.full_name  'Пользователь ' + user.user_id}strong
                ${user.phone  'brspan class=phone' + user.phone + 'span'  ''}
                ${user.username  'brspan class=username@' + user.username + 'span'  ''}
            div
            div class=user-stats
                span${user.message_count} сообщенийspan
                span class=date${formatDate(user.last_message_at)}span
            div
        div
    `).join('');
}

 Открыть диалог
async function openConversation(userId) {
    const data = await fetch(`apiconversation${userId}`).then(r = r.json());
    
    document.getElementById('users-list').style.display = 'none';
    document.getElementById('conversation-view').style.display = 'block';
    
    const messages = data.messages;
    const user = messages[0];
    
    document.getElementById('conversation-title').textContent = 
        user.full_name  'Пользователь ' + userId;
    
    const messagesHtml = messages.map(msg = `
        div class=message ${msg.role}
            div class=message-header
                strong${msg.role === 'user'  'Пользователь'  'Бот'}strong
                span class=time${formatDate(msg.created_at)}span
            div
            div class=message-text${msg.message_text}div
        div
    `).join('');
    
    document.getElementById('messages').innerHTML = messagesHtml;
}
