@app.get(apistatistics)
async def get_statistics(
    session AsyncSession = Depends(get_db_session),
    _ None = Depends(require_auth)
)
    today_start = datetime.combine(date.today(), datetime.min.time())
    today_end = datetime.combine(date.today() + timedelta(days=1), datetime.min.time())
    
    # Уникальные пользователи сегодня
    dialogs_today = await session.execute(
        select(func.count(func.distinct(DialogMessage.user_id)))
        .where(DialogMessage.created_at = today_start, DialogMessage.created_at  today_end)
    )
    
    # Всего пользователей
    dialogs_total = await session.execute(
        select(func.count(func.distinct(DialogMessage.user_id)))
    )
    
    # Лиды
    leads_today = await BitrixLead.get_today_count(session)
    leads_total = await BitrixLead.get_count(session)
    
    return StatisticsResponse(
        dialogs_today=dialogs_today.scalar(),
        dialogs_total=dialogs_total.scalar(),
        leads_today=leads_today,
        leads_total=leads_total
    )
