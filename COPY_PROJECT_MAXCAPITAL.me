Семантический поиск
```python
async def search(self, query str, limit int = 5, similarity_threshold float = 0.25) - List[Tuple[Document, float]]
    # Создать эмбеддинг запроса
    query_embedding = await self.create_embedding(query)
    
    # Поиск по косинусной близости
    results = await Document.search_similar(
        session=self.session,
        query_embedding=query_embedding,
        limit=limit,
        threshold=similarity_threshold
    )
    
    return results
```

Получение контекста для RAG
```python
async def get_context_for_query(self, query str, max_context_length int = 2000) - Optional[str]
    # Поиск похожих документов
    results = await self.search(query, limit=5, similarity_threshold=0.25)
    
    if not results
        return None
    
    # Собрать контекст
    context_parts = []
    current_length = 0
    
    for doc, score in results
        if current_length + len(doc.content_text)  max_context_length
            break
        context_parts.append(f📄 {doc.filename}n{doc.content_text[1000]})
        current_length += len(doc.content_text)
    
    return nn.join(context_parts) if context_parts else None
```

