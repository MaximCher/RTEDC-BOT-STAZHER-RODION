def _format_comment(self, service_name str, comment Optional[str], user_id Optional[int]) - str
    parts = [
        fИсточник Telegram бот MAXCAPITAL,
        fИнтересующая услуга {service_name},
    ]
    
    if user_id
        parts.append(fTelegram ID {user_id})
    
    if comment and comment.strip()
        parts.append(fn{'='40})
        parts.append(fРЕЗЮМЕ ЗАПРОСА КЛИЕНТА)
